{
  "_note": "Fichiers Python chargés dans Pyodide par chaque outil (chemins depuis la racine du site), module importé et fonctions appelées par la page (suffixe _json). Vérifié par tests/python/test_manifeste.py.",
  "versions": {
    "pyodide": "0.27.7",
    "python": "3.12",
    "sympy": "1.13.3",
    "mpmath": "1.3.0"
  },
  "outils": {
    "ensemble-definition": {
      "module": "ensemble_def",
      "fichiers": ["ensemble-definition/ensemble_def.py"],
      "fonctions": ["analyser", "apercu", "verifier"]
    },
    "derivee-variations": {
      "module": "derivee_variations",
      "fichiers": ["ensemble-definition/ensemble_def.py", "derivee-variations/derivee_variations.py"],
      "fonctions": ["apercu", "etudier"]
    },
    "limites-asymptotes": {
      "module": "limites_asymptotes",
      "fichiers": ["ensemble-definition/ensemble_def.py", "limites-asymptotes/limites_asymptotes.py"],
      "fonctions": ["apercu", "etudier"]
    },
    "etude-complete": {
      "module": "etude_complete",
      "fichiers": ["ensemble-definition/ensemble_def.py", "derivee-variations/derivee_variations.py",
                   "limites-asymptotes/limites_asymptotes.py", "etude-complete/etude_complete.py"],
      "fonctions": ["apercu", "etudier", "fenetre"]
    },
    "factorisation": {
      "module": "factorisation",
      "fichiers": ["ensemble-definition/ensemble_def.py", "factorisation/factorisation.py"],
      "fonctions": ["apercu", "exercice", "factoriser"]
    }
  }
}
